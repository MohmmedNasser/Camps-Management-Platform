{
  "name": "camps-platform-backend",
  "private": true,
  "type": "module",
  "description": "Backend tooling for the Displaced Camps Management Platform. The frontend prototype stays dependency-free — these packages exist only for seeding and RLS testing.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "seed": "node seed/seed.mjs",
    "seed:reset": "node seed/seed.mjs --reset",
    "test:schema": "node --test tests/schema.test.mjs",
    "test:rls": "node --test tests/rls.test.mjs",
    "test:phase2": "node --test tests/phase2-business-logic.test.mjs",
    "test:phase3": "node --test tests/phase3-documents.test.mjs",
    "test:browser-smoke": "node --test tests/browser-smoke.test.mjs",
    "test:unit-errors": "node --test tests/unit-errors.test.mjs",
    "test:phase4-auth-frontend": "node --test tests/phase4-auth-frontend.test.mjs",
    "test:phase4.2-dashboard": "node --test tests/phase4.2-dashboard-verification.test.mjs",
    "test:phase4.3-camp-isolation": "node --test tests/phase4.3-camp-isolation.test.mjs",
    "test:phase4.3-dashboard": "node --test tests/phase4.3-dashboard-verification.test.mjs",
    "test:phase4.4-camp-isolation": "node --test tests/phase4.4-camp-isolation.test.mjs",
    "test:phase4.4-families": "node --test tests/phase4.4-families-verification.test.mjs",
    "test:phase4.5-camp-isolation": "node --test tests/phase4.5-camp-isolation.test.mjs",
    "test:phase4.5-displaced": "node --test tests/phase4.5-displaced-verification.test.mjs",
    "test:phase4.6-camp-isolation": "node --test tests/phase4.6-camp-isolation.test.mjs",
    "test:phase4.6-aids": "node --test tests/phase4.6-aids-verification.test.mjs",
    "test:phase4.7-camp-isolation": "node --test tests/phase4.7-camp-isolation.test.mjs",
    "test:all": "npm run test:schema && npm run test:phase2 && npm run test:phase3 && npm run test:browser-smoke && npm run test:unit-errors && npm run test:phase4-auth-frontend && npm run test:phase4.2-dashboard && npm run test:phase4.3-camp-isolation && npm run test:phase4.3-dashboard && npm run test:phase4.4-camp-isolation && npm run test:phase4.4-families && npm run test:phase4.5-camp-isolation && npm run test:phase4.5-displaced && npm run test:phase4.6-camp-isolation && npm run test:phase4.6-aids",
    "frontend:config": "node scripts/write-frontend-config.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.58.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.11",
    "playwright": "^1.62.1"
  }
}
