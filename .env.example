# =============================================================================
# Displaced Camps Management Platform — backend configuration
#
# Copy to .env and fill in from the Supabase dashboard:
#   Project Settings → API   (URL)
#   Project Settings → API Keys
#
# .env is git-ignored. Never commit real values.
# =============================================================================

# Project URL. Safe to expose in the browser.
SUPABASE_URL=https://your-project-ref.supabase.co

# -----------------------------------------------------------------------------
# Publishable key (prefix sb_publishable_…). Legacy projects call this the
# "anon" key. SAFE TO EXPOSE: it goes into the browser, and Row Level Security
# is what actually protects the data behind it.
#
# This is the only key the HTML/CSS/JS frontend may ever see. It is written into
# assets/js/core/supabase-config.js by `npm run frontend:config`.
# -----------------------------------------------------------------------------
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Secret key (prefix sb_secret_…). Legacy projects call this the "service_role"
# key. IT BYPASSES ROW LEVEL SECURITY ENTIRELY.
#
# Server-side only: the seed script and the RLS test suite. It must NEVER appear
# in any file under assets/, in any HTML page, in a browser devtools network
# request, or in git history. If it ever leaks, rotate it immediately in
# Project Settings → API Keys.
# -----------------------------------------------------------------------------
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Direct Postgres connection string. Only needed for `supabase db push`
# against a remote project, or for psql. Contains the database password.
# -----------------------------------------------------------------------------
# SUPABASE_DB_URL=postgresql://postgres.your-project-ref:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# =============================================================================
# Phase 3 — Cloudinary (document storage)
#
# EDGE FUNCTION SECRETS ONLY. These three values are never read from this
# .env by any frontend build step, never written to
# assets/js/core/supabase-config.js, and never sent to a browser. Set them
# directly on the Supabase project instead of relying on this file:
#
#   cd supabase
#   npx supabase secrets set \
#     CLOUDINARY_CLOUD_NAME=your-cloud-name \
#     CLOUDINARY_API_KEY=your-api-key \
#     CLOUDINARY_API_SECRET=your-api-secret \
#     --project-ref <your-project-ref>
#
# Only the three Cloudinary Edge Functions (supabase/functions/documents-*)
# read these, via Deno.env.get(...). If a Cloudinary API secret is ever
# pasted into any file under assets/, any HTML page, or a browser devtools
# network request, rotate it immediately in the Cloudinary console.
# =============================================================================
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret